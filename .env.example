# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI (optional) ────────────────────────────────────────────────────────
# Enables: AI title/slug/SEO generation, AI summary, automatic post translation
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Resend (optional) ────────────────────────────────────────────────────────
# Enables: contact form email delivery
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=contact@hdhmarketfrontier.com

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Configure inside Supabase Dashboard → Authentication → Providers → Google
# These values are entered in Supabase — not needed here
