# ════════════════════════════════════════════════════════════════════════════════
# HDH Market Frontier — Environment Variables Reference
# Copy to .env.local for local development.
# Production values are set as Cloud Run environment variables — not committed.
# NEVER commit .env.local or any file containing real secrets.
# ════════════════════════════════════════════════════════════════════════════════

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Local:      http://localhost:3000
# Production: https://hdhmarketfrontier.com
# ⚠ NEXT_PUBLIC_* vars are baked into JS bundles at build time — must be set before build
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_* are safe for the browser (protected by Supabase RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser or commit
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Enables: AI title/slug/SEO generation, post translation, weekly briefing
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Resend ───────────────────────────────────────────────────────────────────
# Enables: contact form email delivery, weekly briefing notification
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=contact@hdhmarketfrontier.com

# ─── Pioneer Lab — Data License Benchmark Platform ────────────────────────────
# Local dev:  http://localhost:8000  (FastAPI backend running locally)
# Production: https://api.hdhmarketfrontier.com  (when backend is deployed later)
# Leave empty to use mock data — frontend works without the backend
NEXT_PUBLIC_LICENSE_POLICY_API_BASE_URL=

# ─── Weekly Briefing (GitHub Actions only) ────────────────────────────────────
# Optional — enables economic calendar section in weekly market briefing
# Get from: https://finnhub.io/
FINNHUB_API_KEY=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Configure inside Supabase Dashboard → Authentication → Providers → Google
# These values are entered in Supabase — not in this file.
