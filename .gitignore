# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js build output ────────────────────────────────────────────────────
.next/
out/
build/
dist/

# ─── Testing / coverage ──────────────────────────────────────────────────────
coverage/

# ─── Environment variables — NEVER commit real secrets ───────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging

# ─── TypeScript build info ───────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS / editor artifacts ───────────────────────────────────────────────────
.DS_Store
*.pem
.idea/
.vscode/settings.json

# ─── Deployment platforms ────────────────────────────────────────────────────
.vercel/
.netlify/

# ─── Caches ──────────────────────────────────────────────────────────────────
.cache/
.turbo/

# ─── Supabase local dev ──────────────────────────────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env

# ─── Large binary / media files (serve via CDN or Supabase Storage) ──────────
public/images/*.jpg
public/images/*.jpeg
public/images/*.JPEG
public/images/*.png
public/images/*.webp
assets/images/

# ─── Exceptions: profile/brand images needed in production Docker build ───────
!public/images/headshot2.JPEG
!public/images/harry-hwang.jpg
